<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnAdauga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="deschideAdaugare"
        android:text="@string/adauga_sandwich_xml"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvRezultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/niciun_sandwich_adaugat" />

    <EditText
        android:id="@+id/nume_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introduceti_numele"
        android:inputType="text"/>

    <CheckBox
        android:id="@+id/eStudent_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/esti_student"
        />
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="culegeDate"
        android:text="@string/apasa" />

</LinearLayout>